{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/main.ts", "src/main-minimal.ts", "src/preload.ts", "src/bundle.ts", "src/*.d.ts"],
  "exclude": ["src/renderer"]
}
